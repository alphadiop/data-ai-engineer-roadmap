   "source": [
    "tables = spark.sql(\"SHOW TABLES IN dev.spark_db\")\n",
    "\n",
    "delta_tables = [\n",
    "    t.tableName for t in tables.collect()\n",
    "    if spark.sql(f\"DESCRIBE DETAIL dev.spark_db.{t.tableName}\").select(\"format\").first()[0] == \"delta\"\n",
    "]\n",
    "\n",
    "print(delta_tables)"
   ]
  }
